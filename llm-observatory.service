[Unit]
Description=LLM Observatory - live Transformer visualization
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sakurai/llm-observatory
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=CPATH=/home/sakurai/llm-observatory/.native/usr/include:/home/sakurai/llm-observatory/.native/usr/include/python3.12
ExecStart=/home/sakurai/llm-observatory/.venv/bin/uvicorn server:app --host 150.89.227.185 --port 8090
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
